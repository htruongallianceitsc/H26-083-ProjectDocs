    },
    {
      "source": "entities/test.md",
      "destination": "docs/11-quality/test-cases/TC-NOTIFICATION-PUSH-001.md",
      "feature": "push-notification",
      "code": "TC-NOTIFICATION-PUSH-001",
      "type": "test-case"
    }
  ],
  "upgradePolicy": "manual-review",
  "moduleCode": "NOTIFICATION"
}
