{
  "schemaVersion": "1.0",
  "packageId": "push-notification-standard",
  "packageType": "capability",
  "version": "1.0.0",
  "starterSchemaVersion": "5.17.0",
  "summary": "Reusable push notification runtime contract with versioned payload and navigation fallback.",
  "features": {
