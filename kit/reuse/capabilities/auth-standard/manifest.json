{
  "schemaVersion": "1.0",
  "packageId": "auth-standard",
  "packageType": "capability",
  "version": "1.1.0",
  "starterSchemaVersion": "5.17.0",
  "moduleCode": "AUTH",
  "summary": "Reusable production authentication documentation baseline.",
  "features": {
    "required": [
      "login",
      "logout",
      "forgot-password",
      "reset-password"
    ],
    "optional": [
      "register",
      "google-login",
      "email-verification",
      "session-restore",
      "token-refresh",
      "mobile-secure-session"
    ]
  },
  "variables": {
    "AUTH_ROUTE_PREFIX": {
      "type": "string",
      "default": "/auth"
    },
    "AUTH_API_PREFIX": {
      "type": "string",
      "default": "/api/auth"
    },
    "LOGIN_IDENTIFIER": {
      "type": "enum",
      "values": [
        "email",
        "username",
        "phone"
      ],
      "default": "email"
    },
    "GOOGLE_LOGIN_ENABLED": {
      "type": "boolean",
      "default": false
    },
    "REGISTRATION_MODE": {
      "type": "enum",
      "values": [
        "self_service",
        "invite_only",
        "disabled"
      ],
      "default": "disabled"
    },
    "EMAIL_VERIFICATION_REQUIRED": {
      "type": "boolean",
      "default": false
    },
    "SESSION_STRATEGY": {
      "type": "enum",
      "values": [
        "http_only_cookie",
        "mobile_secure_token",
        "external_idp"
      ],
      "default": "http_only_cookie"
    },
    "GOOGLE_DOMAIN_POLICY": {
      "type": "string",
      "default": "unrestricted"
    },
    "SESSION_VALIDATE_ON_RESUME": {
      "type": "boolean",
      "default": true
    },
    "TOKEN_REFRESH_STRATEGY": {
      "type": "enum",
      "values": [
        "none",
        "single_flight"
      ],
      "default": "none"
    },
    "MOBILE_TOKEN_STORAGE": {
      "type": "enum",
      "values": [
        "not_applicable",
        "secure_storage_adapter"
      ],
      "default": "not_applicable"
    }
  },
  "constraints": [
    {
      "if": {
        "variable": "EMAIL_VERIFICATION_REQUIRED",
        "equals": true
      },
      "requireFeature": "email-verification"
    },
    {
      "if": {
        "variable": "GOOGLE_LOGIN_ENABLED",
        "equals": true
      },
      "requireFeature": "google-login"
    },
    {
      "if": {
        "variable": "REGISTRATION_MODE",
        "equals": "disabled"
      },
      "forbidFeature": "register"
    },
    {
      "if": {
        "variable": "TOKEN_REFRESH_STRATEGY",
        "equals": "single_flight"
      },
      "requireFeature": "token-refresh"
    },
    {
      "if": {
        "variable": "MOBILE_TOKEN_STORAGE",
        "equals": "secure_storage_adapter"
      },
      "requireFeature": "mobile-secure-session"
    }
  ],
