{
  "schemaVersion": "1.0",
  "bundleFormat": "project-documentation-bundle",
  "bundleSchemaVersion": 1,
  "exportDirectory": ".project-docs/exports",
  "importDirectory": ".project-docs/imports",
  "portableRoots": ["docs"],
  "excludedProjectDocPrefixes": [
    "docs/_generated/",
    "docs/guides/",
    "docs/history/"
  ],
  "entityTargets": {
    "project": { "strategy": "flat", "directory": "docs/00-project" },
    "document": { "strategy": "preserve-or-flat", "directory": "docs/00-project" },
    "review": { "strategy": "flat", "directory": "docs/00-project/reviews" },
    "module": { "strategy": "module", "directory": "docs/02-modules" },
    "feature": { "strategy": "feature", "directory": "docs/02-modules", "moduleRelationField": "modules" },
    "requirement": { "strategy": "flat", "directory": "docs/03-requirements/functional" },
    "business-rule": { "strategy": "flat", "directory": "docs/04-business-rules" },
    "screen": { "strategy": "flat", "directory": "docs/05-screens" },
    "ui-component": { "strategy": "flat", "directory": "docs/05-screens/shared/components" },
    "screen-shell": { "strategy": "flat", "directory": "docs/05-screens/shared/shells" },
    "flow": { "strategy": "preserve-subdir", "directory": "docs/06-flows", "subdirs": ["business", "user", "system", "sequence"] },
    "api": { "strategy": "flat", "directory": "docs/07-api" },
    "database-object": { "strategy": "preserve-subdir", "directory": "docs/08-database", "subdirs": ["tables", "views", "functions", "data-rules"], "fallbackSubdir": "tables" },
    "integration": { "strategy": "flat", "directory": "docs/09-architecture/integrations" },
    "nfr": { "strategy": "flat", "directory": "docs/03-requirements/non-functional" },
    "test-case": { "strategy": "flat", "directory": "docs/11-quality/test-cases" },
    "runbook": { "strategy": "flat", "directory": "docs/13-operations/runbooks" },
    "decision": { "strategy": "flat", "directory": "docs/15-decisions" },
    "release": { "strategy": "flat", "directory": "docs/16-release/releases" },
    "open-question": { "strategy": "flat", "directory": "docs/19-open-items" },
    "permission": { "strategy": "flat", "directory": "docs/20-mobile/permissions" },
    "native-capability": { "strategy": "flat", "directory": "docs/20-mobile/native-capabilities" },
    "deep-link": { "strategy": "flat", "directory": "docs/20-mobile/deep-links" },
    "push-event": { "strategy": "flat", "directory": "docs/20-mobile/push-events" },
    "local-storage": { "strategy": "flat", "directory": "docs/20-mobile/local-storage" },
    "sync-policy": { "strategy": "flat", "directory": "docs/20-mobile/sync-policies" },
    "background-job-mobile": { "strategy": "flat", "directory": "docs/20-mobile/background-work" },
    "analytics-event": { "strategy": "flat", "directory": "docs/20-mobile/analytics-events" },
    "feature-flag": { "strategy": "flat", "directory": "docs/20-mobile/feature-flags" },
    "device-test-profile": { "strategy": "flat", "directory": "docs/20-mobile/device-test-profiles" },
    "request": { "strategy": "flat", "directory": "docs/21-requests" },
    "task": { "strategy": "flat", "directory": "docs/22-tasks" },
    "bug": { "strategy": "flat", "directory": "docs/23-bugs" },
    "application": { "strategy": "flat", "directory": "docs/24-applications" }
  }
}
