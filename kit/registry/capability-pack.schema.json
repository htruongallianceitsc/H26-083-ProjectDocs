{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-pack.schema.json",
  "title": "Reusable Pack Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "packageType",
    "version",
    "starterSchemaVersion",
    "features",
    "variables",
    "files",
    "upgradePolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "packageType": {
      "enum": [
        "pattern",
        "capability"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "starterSchemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "moduleCode": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variables": {
      "type": "object"
    },
    "constraints": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "destination"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "upgradePolicy": {
      "enum": [
        "fork",
        "track-upstream",
        "manual-review"
      ]
    }
  },
  "additionalProperties": true
}
