      ]
    },
    {
      "id": "mobile-device-release-profile",
      "severity": "warning",
      "type": "body-contains",
      "entityType": "device-test-profile",
      "projectType": "mobile",
      "terms": [
        "iOS Matrix",
        "Android Matrix",
        "Lifecycle Transitions",
        "Network Conditions",
        "Release Gate"
      ]
    }
  ]
}
