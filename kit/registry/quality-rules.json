{
  "schemaVersion": "1.0",
  "rules": [
    {
      "id": "feature-requirement",
      "severity": "warning",
      "type": "relation-min",
      "entityType": "feature",
      "field": "requirements",
      "min": 1,
      "minSpecLevel": "standard"
    },
    {
      "id": "feature-test",
      "severity": "warning",
      "type": "relation-min",
      "entityType": "feature",
      "field": "tests",
      "min": 1,
      "minSpecLevel": "standard"
    },
    {
      "id": "requirement-acceptance-coverage",
      "severity": "error",
      "type": "requirement-acceptance-coverage",
      "entityType": "requirement",
      "statusIn": [
        "approved",
        "in_progress",
        "implemented"
      ],
      "requireStableIds": true,
      "requireTests": true,
      "requireEveryCriterionCovered": true
    },
    {
      "id": "critical-business-rule-verification",
      "severity": "error",
      "type": "business-rule-polarity-coverage",
      "entityType": "business-rule",
      "statusIn": [
        "approved"
      ],
      "criticalityIn": [
        "critical"
      ],
      "polarities": [
        "positive",
        "negative"
      ]
    },
    {
      "id": "mobile-screen-states",
      "severity": "warning",
      "type": "body-contains",
      "entityType": "screen",
      "projectType": "mobile",
      "terms": [
        "UI states",
        "Loading",
        "Error"
      ]
    },
    {
      "id": "permission-denied-flow",
      "severity": "error",
      "type": "body-contains",
      "entityType": "permission",
      "projectType": "mobile",
      "terms": [
        "denied",
        "revoked",
        "purpose"
      ]
    },
    {
      "id": "blocking-open-question",
      "severity": "error",
      "type": "status",
      "entityType": "open-question",
      "statusIn": [
        "blocked"
      ]
    },
    {
      "id": "pack-review-pending",
      "severity": "error",
      "type": "pack-review-pending"
    },
    {
      "id": "task-feature-link",
      "severity": "warning",
      "type": "relation-min",
      "entityType": "task",
      "field": "features",
      "min": 1
    },
    {
      "id": "accepted-request-promotion",
      "severity": "warning",
      "type": "relation-min",
      "entityType": "request",
      "field": "promoted_to",
      "min": 1,
      "statusIn": [
        "accepted",
        "promoted"
      ]
    },
    {
      "id": "stale-documentation",
      "severity": "error",
      "type": "freshness-stale"
    }
  ]
}
