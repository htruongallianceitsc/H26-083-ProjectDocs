      "type": "body-contains",
      "entityType": "push-event",
      "projectType": "mobile",
      "terms": [
        "Payload Schema",
        "Sensitive Data Policy",
        "Foreground Behaviour",
        "Background Behaviour",
        "Terminated Behaviour"
      ]
    },
    {
      "id": "mobile-local-storage-lifecycle",
      "severity": "error",
      "type": "body-contains",
      "entityType": "local-storage",
      "projectType": "mobile",
      "terms": [
        "Migration",
        "Logout Cleanup",
        "Corruption Recovery"
      ]
    },
    {
      "id": "mobile-sync-conflict-idempotency",
      "severity": "error",
      "type": "body-contains",
      "entityType": "sync-policy",
      "projectType": "mobile",
      "terms": [
