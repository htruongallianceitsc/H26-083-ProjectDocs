{
  "schemaVersion": "1.0",
  "rules": [
    {
      "id": "feature-requirement",
      "severity": "warning",
      "type": "relation-min",
      "entityType": "feature",
      "field": "requirements",
      "min": 1
    },
    {
      "id": "feature-test",
      "severity": "warning",
      "type": "relation-min",
      "entityType": "feature",
      "field": "tests",
      "min": 1
    },
    {
      "id": "mobile-screen-states",
      "severity": "warning",
      "type": "body-contains",
      "entityType": "screen",
      "projectType": "mobile",
      "terms": [
        "UI states",
        "Loading",
        "Error"
      ]
    },
    {
      "id": "permission-denied-flow",
      "severity": "error",
      "type": "body-contains",
      "entityType": "permission",
      "projectType": "mobile",
      "terms": [
        "denied",
        "revoked",
        "purpose"
      ]
    },
    {
      "id": "blocking-open-question",
      "severity": "error",
      "type": "status",
      "entityType": "open-question",
      "statusIn": [
        "blocked"
      ]
    },
    {
      "id": "pack-review-pending",
      "severity": "error",
      "type": "pack-review-pending"
    }
  ]
}
