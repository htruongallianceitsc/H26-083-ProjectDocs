{
  "name": "production-project-docs-tools",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "profile:check": "node scripts/docs-tool.mjs profile",
    "docs:validate": "node scripts/docs-tool.mjs validate",
    "docs:sync": "node scripts/docs-tool.mjs sync",
    "docs:build": "node scripts/docs-tool.mjs build",
    "docs:check-site": "node scripts/docs-tool.mjs check-site",
    "docs:serve": "node scripts/docs-tool.mjs serve",
    "docs:vendor": "node scripts/vendor-mermaid.mjs",
    "docs:all": "npm run profile:check && npm run pack:validate && npm run docs:validate && npm run docs:sync && npm run docs:build && npm run docs:check-site",
    "pack:validate": "node scripts/pack-tool.mjs validate",
    "pack:list": "node scripts/pack-tool.mjs list",
    "reuse:assess": "node scripts/pack-tool.mjs assess",
    "pack:import": "node scripts/pack-tool.mjs import",
    "pack:review": "node scripts/pack-tool.mjs review",
    "pack:diff": "node scripts/pack-tool.mjs diff",
    "pack:upgrade": "node scripts/pack-tool.mjs upgrade",
    "docs:clean": "node scripts/docs-tool.mjs clean",
    "docs:dev": "node scripts/docs-tool.mjs watch"
  }
}
