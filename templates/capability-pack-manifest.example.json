{
  "schemaVersion": "1.0",
  "packageId": "example-capability",
  "version": "1.0.0",
  "starterSchemaRange": ">=3.0.0 <4.0.0",
  "moduleCode": "MOD-EXAMPLE",
  "description": "Reusable capability baseline.",
  "defaultTargetRoot": "docs/02-modules/EXAMPLE",
  "features": {
    "required": ["core-feature"],
    "optional": {
      "optional-feature": {"defaultEnabled": false}
    }
  },
  "variables": {
    "OWNER": {"type": "string", "default": "Product & Engineering"},
    "POLICY_MODE": {"type": "enum", "allowed": ["a", "b"], "default": "a", "reviewRequired": true}
  },
  "dependencies": [],
  "files": [
    {
      "path": "entities/core/module.md",
      "destination": "module.md",
      "entityCode": "MOD-EXAMPLE",
      "feature": "core"
    }
  ],
  "provenance": {"source": "capability-library", "commit": null},
  "upgradePolicy": "track-upstream"
}
