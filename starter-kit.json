{
  "name": "production-project-docs-starter-kit",
  "version": "5.18.0",
  "schemaVersion": "5.18.0",
  "registrySchemaVersion": "1.0",
  "capabilityPackSchemaVersion": "1.0",
  "workPlanSchemaVersion": "1.2",
  "readinessRulesVersion": "1.0",
  "freshnessRulesVersion": "1.0",
  "impactRulesVersion": "1.0",
  "changeManagementVersion": "1.0",
  "specProfilesVersion": "1.0",
  "documentationLayoutVersion": "1.0",
  "documentationLayout": {
    "historyDirectory": "docs/history",
    "guidesDirectory": "docs/guides",
    "rootHistoryPatterns": [
      "^V\\d+(?:_\\d+)*_(?:UPGRADE_NOTES|QA_REPORT)\\.md$",
      "^V\\d+_.*_UPGRADE\\.md$",
      "^REVIEW_UPGRADE_NOTES\\.md$",
      "^REUSE_STRATEGY_.*\\.md$"
    ]
  },
  "sourceProfilesVersion": "1.0",
  "sourceBaseSchemaVersion": "1.0",
  "sourceWorkspaceVersion": "1.0",
  "entityModelVersion": "1.1",
  "relationModelVersion": "1.1",
  "sourceIntelligenceVersion": "1.0",
  "localKnowledgeEngineVersion": "1.0",
  "doctorVersion": "1.0",
  "workspaceLayoutVersion": "1.0",
  "workspaceLayout": {
    "docs": "docs",
    "runtime": ".project-docs",
    "kit": "kit",
    "registry": "kit/registry",
    "standards": "kit/standards",
    "prompts": "kit/prompts",
    "templates": "kit/templates",
    "workflows": "kit/workflows",
    "sourceBases": "kit/source-bases",
    "reuse": {
      "capabilities": "kit/reuse/capabilities",
      "patterns": "kit/reuse/patterns",
      "templates": "kit/reuse/templates"
    },
    "examples": "kit/examples",
    "site": ".project-docs/site",
    "tools": "tools",
    "source": {
      "apps": "apps",
      "packages": "packages",
      "tests": "tests",
      "infra": "infra"
    },
    "mockups": "mockups"
  },
  "legacyLayoutAliases": {
    "registry": "registry",
    "standards": "standards",
    "prompts": "prompts",
    "templates": "templates",
    "workflows": "workflows",
    "sourceBases": "source-bases",
    "reuse.capabilities": "reusable-modules",
    "reuse.patterns": "reusable-patterns",
    "reuse.templates": "reusable-templates",
    "examples.profile": "PROJECT_PROFILE.example.json",
    "site": "site"
  },
  "brownfieldVersion": "1.0",
  "blueprintProjectionVersion": "1.0",
  "mockupWorkflowVersion": "1.0",
  "mockupWorkflow": {
    "assetRoot": "mockups",
    "runtimeDirectory": ".project-docs/mockups",
    "config": "kit/registry/mockup-workflow.json"
  },
  "wireframeWorkflowVersion": "1.3",
  "wireframePromotionVersion": "1.0",
  "wireframeWorkflow": {
    "runtimeDirectory": ".project-docs/wireframes",
    "config": "kit/registry/wireframe-workflow.json",
    "promotionSchema": "kit/registry/wireframe-promotion.schema.json"
  },
  "documentationBundleVersion": "1.0",
  "documentationBundleSchemaVersion": "1",
  "documentationBundle": {
    "format": "project-documentation-bundle",
    "config": "kit/registry/documentation-bundle.json",
    "exportDirectory": ".project-docs/exports",
    "importDirectory": ".project-docs/imports"
  },
  "reactNativeProductionVersion": "2.0",
  "reactNativeDependencyBaselineVersion": "1.0",
  "mobileReuseLibraryVersion": "1.0",
  "generatedArtifactsPolicyVersion": "1.0"
}
